# MetaTrader 5 desktop terminal (leave blank for default installation)
MT5_PATH=

# Exact broker symbol shown in MT5 Market Watch (may include a suffix)
MT5_SYMBOL=XAUUSD

# Candle timeframe and history
MT5_TIMEFRAME=M15
MT5_CANDLE_COUNT=300

# Trading is OFF by default. DEMO requires both settings below.
TRADING_MODE=READ_ONLY
ENABLE_DEMO_TRADING=false
REQUIRE_DEMO_ACCOUNT=true

# Conservative initial demo limits
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.01
MAX_SPREAD_PRICE=0.50
POLL_SECONDS=10
